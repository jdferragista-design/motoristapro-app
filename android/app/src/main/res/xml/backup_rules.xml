<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 (API 30) e anteriores: cloud backup -->
<full-backup-content>
    <!-- Histórico financeiro fica no WebView (localStorage). Não sai do
         aparelho para o Google Drive: o backup é feito pelo próprio app. -->
    <exclude domain="root" path="app_webview" />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <include domain="sharedpref" path="." />
</full-backup-content>
